{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js?__p=$1" },
    { "src": "/(anime|nonton|donghua|jadwal|ongoing|koleksi|favorit|riwayat)(/.*)?", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.js?__p=$1" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "public/**"
    }
  }
}
